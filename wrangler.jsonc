{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bardapraia",
  "main": "dist/index.js",
  "compatibility_date": "2026-03-29",
  "compatibility_flags": ["nodejs_compat"],
  // Keep the variables set in the Cloudflare dashboard when a new version is deployed
  // (without this, each deploy removes any plain-text variable that is not listed here)
  "keep_vars": true,
  // Static files in public/ (sw.js, brand images, fonts) are served directly by Cloudflare;
  // every other request (/, /api/*) goes to the Hono worker.
  "assets": {
    "directory": "./public"
  },
  // Once a day (06:23 UTC): Reputation → Google reads the rating and the latest reviews
  "triggers": {
    "crons": ["23 6 * * *"]
  }
  // Secrets (VAPID_PRIVATE, SB_SERVICE_KEY, GOOGLE_PLACES_KEY) are set in the Cloudflare dashboard as type "Secret":
  // Workers & Pages → bardapraia → Settings → Variables and Secrets.
  // Locally they come from .dev.vars (see .dev.vars.example).
}
