{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bardapraia",
  "main": "dist/index.js",
  "compatibility_date": "2026-03-29",
  "compatibility_flags": ["nodejs_compat"],
  // Static files in public/ (sw.js, static/style.css) are served directly by Cloudflare;
  // every other request (/, /api/*) goes to the Hono worker.
  "assets": {
    "directory": "./public"
  }
  // Secrets (VAPID_PRIVATE) are set in the Cloudflare dashboard:
  // Workers & Pages → bardapraia → Settings → Variables and Secrets.
  // Locally they come from .dev.vars (see .dev.vars.example).
}
